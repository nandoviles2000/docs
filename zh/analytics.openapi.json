    "/v1/analytics/{projectId}/views": {
      "get": {
        "summary": "获取页面浏览量",
        "description": "按路径和全站范围返回内容浏览事件计数，并按人工流量和 AI 流量分别统计。",
        "tags": [
          "Analytics"
        ],
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "$ref": "#/components/parameters/projectId"
          },
          {
            "schema": {
              "type": "string",
              "description": "采用 ISO 8601 或 YYYY-MM-DD 格式的日期",
              "example": "2024-01-01"
            },
            "required": false,
            "name": "dateFrom",
            "in": "query"
          },
          {
            "schema": {
              "type": "string",
              "description": "采用 ISO 8601 或 YYYY-MM-DD 格式的日期。`dateTo` 为排他性上限。结果包含指定日期之前的日期，但不包含该日期当天。",
              "example": "2024-01-01"
            },
            "required": false,
            "name": "dateTo",
            "in": "query"
          },
          {
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 250,
              "default": 50,
              "description": "每页最多返回的结果数（1-250，默认 50）。当 hasMore 为 true 时，每次将 offset 增加 limit 以进行分页。"
            },
            "required": false,
            "name": "limit",
            "in": "query"
          },
          {
            "schema": {
              "type": "integer",
              "minimum": 0,
              "default": 0,
              "description": "要跳过的行数。对于按页访问，请使用 offset = (page - 1) * limit。"
            },
            "required": false,
            "name": "offset",
            "in": "query"
          }
        ],
        "responses": {
          "200": {
            "description": "全站和各路径的内容浏览事件计数",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ViewsByPageResponse"
