{
  "openapi": "3.1.0",
  "info": {
    "title": "Mintlify Analytics Export API",
    "version": "1.0.0",
    "description": "API pour exporter les données d’analyses de la documentation"
  },
  "servers": [
    {
      "url": "https://api.mintlify.com",
      "description": "Production"
    }
  ],
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "description": "L’en-tête Authorization attend un jeton Bearer. Utilisez une clé API administrateur (préfixée par `mint_`). Il s’agit d’une clé secrète côté serveur. Générez-en une sur la [page des clés API](https://dashboard.mintlify.com/settings/organization/api-keys) de votre tableau de bord."
      }
    },
    "schemas": {
      "projectId": {
        "type": "string",
        "description": "L’ID de votre projet. Vous pouvez le copier depuis la page des [clés API](https://dashboard.mintlify.com/settings/organization/api-keys) de votre tableau de bord."
      },
      "FeedbackResponse": {
        "type": "object",
        "properties": {
          "feedback": {
            "type": "array",
            "description": "Liste des retours.",
            "items": {
              "anyOf": [
                {
                  "description": "Renvoyé lorsque la source est `contextual`. Indique si l’utilisateur a trouvé la page utile et inclut éventuellement une adresse e-mail de contact.",
                  "type": "object",
                  "properties": {
                    "id": {
                      "type": "string",
                      "description": "Identifiant unique du retour."
                    },
                    "path": {
                      "type": "string",
                      "description": "Chemin ou URL du document source."
                    },
                    "comment": {
                      "type": [
                        "string",
                        "null"
                      ],
                      "description": "Texte du commentaire de l’utilisateur."
                    },
                    "createdAt": {
                      "type": [
                        "string",
                        "null"
                      ],
                      "description": "Horodatage de l’envoi du retour."
                    },
                    "source": {
                      "type": "string",
                      "enum": [
                        "code_snippet",
                        "contextual",
                        "agent",
                        "thumbs_only"
                      ],
                      "description": "Origine du retour. `code_snippet` désigne un retour sur un bloc de code, `contextual` un retour au niveau de la page, `agent` un retour envoyé par un agent d’IA tiers, et `thumbs_only` un vote positif ou négatif."
                    },
                    "status": {
                      "type": "string",
                      "enum": [
                        "pending",
                        "in_progress",
                        "resolved",
                        "dismissed"
                      ],
                      "description": "État actuel de révision du retour."
                    },
                    "helpful": {
                      "type": "boolean",
                      "description": "Indique si l’utilisateur a trouvé le contenu utile."
                    },
                    "contact": {
                      "type": [
                        "string",
                        "null"
                      ],
                      "description": "Adresse e-mail fournie par l’utilisateur pour le suivi."
                    }
                  },
                  "required": [
                    "id",
                    "path",
                    "comment",
                    "createdAt",
                    "source",
                    "status",
                    "helpful",
                    "contact"
                  ]
                },
                {
                  "description": "Renvoyé lorsque la source est `code_snippet`. Inclut le code, le nom du fichier et le langage de l’extrait auquel le retour se rapporte.",
                  "type": "object",
                  "properties": {
                    "id": {
                      "type": "string",
                      "description": "Identifiant unique du retour."
                    },
                    "path": {
                      "type": "string",
                      "description": "Chemin ou URL du document source."
                    },
                    "comment": {
                      "type": [
                        "string",
                        "null"
                      ],
                      "description": "Texte du commentaire de l’utilisateur."
                    },
                    "createdAt": {
                      "type": [
                        "string",
                        "null"
                      ],
                      "description": "Horodatage de l’envoi du retour."
                    },
                    "source": {
                      "type": "string",
                      "enum": [
                        "code_snippet",
                        "contextual",
                        "agent",
                        "thumbs_only"
                      ],
                      "description": "Origine du retour. `code_snippet` désigne un retour sur un bloc de code, `contextual` un retour au niveau de la page, `agent` un retour envoyé par un agent d’IA tiers, et `thumbs_only` un vote positif ou négatif."
                    },
                    "status": {
                      "type": "string",
                      "enum": [
                        "pending",
                        "in_progress",
                        "resolved",
                        "dismissed"
                      ],
                      "description": "État actuel de révision du retour."
                    },
                    "code": {
                      "type": "string",
                      "description": "Extrait de code concerné par le retour."
                    },
                    "filename": {
                      "type": [
                        "string",
                        "null"
                      ],
                      "description": "Nom du fichier associé à l’extrait de code."
                    },
                    "lang": {
                      "type": [
                        "string",
                        "null"
                      ],
                      "description": "Langage de programmation de l’extrait de code."
                    }
                  },
                  "required": [
                    "id",
                    "path",
                    "comment",
                    "createdAt",
                    "source",
                    "status",
                    "code",
                    "filename",
                    "lang"
                  ]
                },
                {
                  "description": "Renvoyé lorsque la source est `agent` ou `thumbs_only`. Contient uniquement les champs de base du retour.",
                  "type": "object",
                  "properties": {
                    "id": {
                      "type": "string",
                      "description": "Identifiant unique du retour."
                    },
                    "path": {
                      "type": "string",
                      "description": "Chemin ou URL du document source."
                    },
                    "comment": {
                      "type": [
                        "string",
                        "null"
                      ],
                      "description": "Texte du commentaire de retour de l’utilisateur."
                    },
                    "createdAt": {
                      "type": [
                        "string",
                        "null"
                      ],
                      "description": "Horodatage de l’envoi du retour."
                    },
                    "source": {
                      "type": "string",
                      "enum": [
                        "code_snippet",
                        "contextual",
                        "agent",
                        "thumbs_only"
                      ],
                      "description": "Origine du retour. `code_snippet` indique un retour sur un bloc de code, `contextual` un retour au niveau de la page, `agent` un retour envoyé par un agent d’IA tiers, et `thumbs_only` un vote positif ou négatif."
                    },
                    "status": {
                      "type": "string",
                      "enum": [
                        "pending",
                        "in_progress",
                        "resolved",
                        "dismissed"
                      ],
                      "description": "État actuel de révision du retour."
                    }
                  },
                  "required": [
                    "id",
                    "path",
                    "comment",
                    "createdAt",
                    "source",
                    "status"
                  ]
                }
              ]
            }
          },
          "nextCursor": {
            "type": [
              "string",
              "null"
            ],
            "description": "Curseur permettant de récupérer la page de résultats suivante. `null` s’il n’y a plus de résultats."
          },
          "hasMore": {
            "type": "boolean",
            "description": "Indique si des résultats supplémentaires sont disponibles au-delà de cette page."
          }
        },
        "required": [
          "feedback",
          "nextCursor",
          "hasMore"
        ]
      },
      "AnalyticsErrorResponse": {
        "type": "object",
        "properties": {
          "error": {
            "type": "string",
            "description": "Message d’erreur décrivant ce qui s’est mal passé."
          },
          "details": {
            "type": "array",
            "description": "Détails supplémentaires sur l’erreur.",
            "items": {
              "type": "object",
              "properties": {
                "message": {
                  "type": "string",
                  "description": "Description d’une erreur spécifique de validation ou de traitement."
                }
              },
              "required": [
                "message"
              ]
            }
          }
        },
        "required": [
          "error"
        ]
      },
      "AssistantConversationsResponse": {
        "type": "object",
        "properties": {
          "conversations": {
            "type": "array",
            "description": "Liste des conversations avec l’assistant.",
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string",
                  "description": "Identifiant unique de la conversation."
                },
                "timestamp": {
                  "type": "string",
                  "description": "Horodatage de la conversation."
                },
                "query": {
                  "type": "string",
                  "description": "Question posée par l’utilisateur à l’assistant."
                },
                "response": {
                  "type": "string",
                  "description": "Réponse de l’assistant."
                },
                "sources": {
                  "type": "array",
                  "description": "Pages de documentation référencées dans la réponse.",
                  "items": {
                    "type": "object",
                    "properties": {
                      "title": {
                        "type": "string",
                        "description": "Titre de la page de documentation référencée."
                      },
                      "url": {
                        "type": "string",
                        "description": "URL de la page de documentation référencée."
                      }
                    },
                    "required": [
                      "title",
                      "url"
                    ]
                  }
                },
                "queryCategory": {
                  "type": [
                    "string",
                    "null"
                  ],
                  "description": "Catégorie de regroupement attribuée automatiquement à la conversation, le cas échéant."
                }
              },
              "required": [
                "id",
                "timestamp",
                "query",
                "response",
                "sources",
                "queryCategory"
              ]
            }
          },
          "nextCursor": {
            "type": [
              "string",
              "null"
            ],
            "description": "Curseur permettant de récupérer la page de résultats suivante. `null` s’il n’y a plus de résultats."
          },
          "hasMore": {
            "type": "boolean",
            "description": "Indique si des résultats supplémentaires sont disponibles au-delà de cette page."
          }
        },
        "required": [
          "conversations",
          "nextCursor",
          "hasMore"
        ]
      },
      "FeedbackGroupedByPageResponse": {
        "type": "object",
        "properties": {
          "feedback": {
            "type": "array",
            "description": "Nombre de retours agrégés par chemin de page de documentation.",
            "items": {
              "type": "object",
              "properties": {
                "path": {
                  "type": "string",
                  "description": "Chemin de la page de documentation."
                },
                "thumbsUp": {
                  "type": "number",
                  "description": "Nombre de retours contextuels positifs (pouces levés)."
                },
                "thumbsDown": {
                  "type": "number",
                  "description": "Nombre de retours contextuels négatifs (pouces baissés)."
                },
                "code": {
                  "type": "number",
                  "description": "Nombre de retours sur des extraits de code."
                },
                "total": {
                  "type": "number",
                  "description": "Nombre total de retours pour cette page."
                }
              },
              "required": [
                "path",
                "thumbsUp",
                "thumbsDown",
                "code",
                "total"
              ]
            }
          },
          "hasMore": {
            "type": "boolean",
            "description": "Indique si des résultats supplémentaires sont disponibles au-delà de cette page."
          }
        },
        "required": [
          "feedback",
          "hasMore"
        ]
      },
      "SearchesResponse": {
        "type": "object",
        "properties": {
          "searches": {
            "type": "array",
            "description": "Termes de recherche classés par nombre d’occurrences décroissant.",
            "items": {
              "type": "object",
              "properties": {
                "searchQuery": {
                  "type": "string",
                  "description": "Terme de recherche saisi par les utilisateurs."
                },
                "hits": {
                  "type": "number",
                  "description": "Nombre de fois où ce terme a été recherché."
                },
                "ctr": {
                  "type": "number",
                  "description": "Taux de clics pour ce terme de recherche."
                },
                "topClickedPage": {
                  "type": [
                    "string",
                    "null"
                  ],
                  "description": "Chemin du résultat le plus cliqué pour cette requête, le cas échéant."
                },
                "lastSearchedAt": {
                  "type": "string",
                  "description": "Horodatage de la dernière fois où ce terme a été recherché."
                }
              },
              "required": [
                "searchQuery",
                "hits",
                "ctr",
                "topClickedPage",
                "lastSearchedAt"
              ]
            }
          },
          "totalSearches": {
            "type": "integer",
            "minimum": 0,
            "description": "Nombre total d'événements de recherche dans l'intervalle de dates demandé (somme de toutes les occurrences, et non des requêtes distinctes)."
          },
          "nextCursor": {
            "type": [
              "string",
              "null"
            ],
            "description": "Curseur de pagination opaque pour la page suivante. `null` s'il n'y a pas d'autres résultats."
          }
        },
        "required": [
          "searches",
          "totalSearches",
          "nextCursor"
        ]
      },
      "ViewsTrafficTotals": {
        "type": "object",
        "properties": {
          "human": {
            "type": "number",
            "description": "Événements de consultation de contenu sur l'ensemble du site provenant du trafic humain."
          },
          "ai": {
            "type": "number",
            "description": "Événements de consultation de contenu sur l'ensemble du site provenant du trafic de bots d'IA."
          },
          "total": {
            "type": "number",
            "description": "Événements de consultation de contenu sur l'ensemble du site."
          }
        },
        "required": [
          "human",
          "ai",
          "total"
        ]
      },
      "ViewsByPageResponse": {
        "type": "object",
        "properties": {
          "totals": {
            "$ref": "#/components/schemas/ViewsTrafficTotals",
            "description": "Total des consultations sur l'ensemble du site pour l'intervalle de dates."
          },
          "views": {
            "type": "array",
            "description": "Nombre de consultations par page.",
            "items": {
              "type": "object",
              "properties": {
                "path": {
                  "type": "string",
                  "description": "Chemin de la page de documentation."
                },
                "human": {
                  "type": "number",
                  "description": "Événements de consultation de contenu sur ce chemin provenant du trafic humain."
                },
                "ai": {
                  "type": "number",
                  "description": "Événements de consultation de contenu sur ce chemin provenant du trafic de bots d'IA."
                },
                "total": {
                  "type": "number",
                  "description": "Nombre total d'événements de consultation de contenu sur ce chemin."
                }
              },
              "required": [
                "path",
                "human",
                "ai",
                "total"
              ]
            }
          },
          "hasMore": {
            "type": "boolean",
            "description": "Indique si des résultats supplémentaires sont disponibles au-delà de cette page."
          }
        },
        "required": [
          "totals",
          "views",
          "hasMore"
        ]
      },
      "AssistantCallerStatsResponse": {
        "type": "object",
        "properties": {
          "web": {
            "type": "number",
            "description": "Nombre de requêtes de l'assistant provenant du web (site de documentation)."
          },
          "api": {
            "type": "number",
            "description": "Nombre de requêtes de l'assistant provenant d'appels API."
          },
          "other": {
            "type": "number",
            "description": "Nombre de requêtes de l'assistant provenant d'autres sources (p. ex., intégrations, SDK)."
          },
          "total": {
            "type": "number",
            "description": "Nombre total de requêtes de l'assistant, tous types d'appelants confondus."
          }
        },
        "required": [
          "web",
          "api",
          "other",
          "total"
        ]
      },
      "VisitorsTrafficTotals": {
        "type": "object",
        "properties": {
          "human": {
            "type": "number",
            "description": "Visiteurs uniques sur l'ensemble du site provenant du trafic humain."
          },
          "ai": {
            "type": "number",
            "description": "Visiteurs uniques sur l'ensemble du site provenant du trafic de bots d'IA."
          },
          "total": {
            "type": "number",
            "description": "Nombre approximatif de visiteurs distincts sur l'ensemble du site ayant au moins une consultation admissible (dédupliqués entre humains et IA)."
          }
        },
        "required": [
          "human",
          "ai",
          "total"
        ]
      },
      "VisitorsByPageResponse": {
        "type": "object",
        "properties": {
          "totals": {
            "$ref": "#/components/schemas/VisitorsTrafficTotals",
            "description": "Total des visiteurs uniques sur l'ensemble du site pour l'intervalle de dates."
          },
          "visitors": {
            "type": "array",
            "description": "Nombre de visiteurs par page.",
            "items": {
              "type": "object",
              "properties": {
                "path": {
                  "type": "string",
                  "description": "Chemin de la page de documentation."
                },
                "human": {
                  "type": "number",
                  "description": "Visiteurs uniques provenant du trafic humain."
                },
                "ai": {
                  "type": "number",
                  "description": "Visiteurs uniques provenant du trafic de bots d'IA."
                },
                "total": {
                  "type": "number",
                  "description": "Nombre approximatif de visiteurs distincts ayant au moins une consultation admissible sur ce chemin (dédupliqués entre humains et IA)."
                }
              },
              "required": [
                "path",
                "human",
                "ai",
                "total"
              ]
            }
          },
          "hasMore": {
            "type": "boolean",
            "description": "Indique si des résultats supplémentaires sont disponibles au-delà de cette page."
          }
        },
        "required": [
          "totals",
          "visitors",
          "hasMore"
        ]
      }
    },
    "parameters": {
      "projectId": {
        "schema": {
          "$ref": "#/components/schemas/projectId"
        },
        "required": true,
        "name": "projectId",
        "in": "path"
      }
    }
  },
  "paths": {
    "/v1/analytics/{projectId}/feedback": {
      "get": {
        "summary": "Récupérer les retours utilisateurs",
        "description": "Renvoie des retours d'utilisateurs paginés avec filtrage facultatif",
        "tags": [
          "Analytics"
        ],
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "$ref": "#/components/parameters/projectId"
          },
          {
            "schema": {
              "type": "string",
              "description": "Date au format ISO 8601 ou YYYY-MM-DD",
              "example": "2024-01-01"
            },
            "required": false,
            "name": "dateFrom",
            "in": "query"
          },
          {
            "schema": {
              "type": "string",
              "description": "Date au format ISO 8601 ou YYYY-MM-DD. `dateTo` est une limite supérieure exclusive. Les résultats incluent les dates antérieures à la date spécifiée, mais pas la date elle-même.",
              "example": "2024-01-01"
            },
            "required": false,
            "name": "dateTo",
            "in": "query"
          },
          {
            "schema": {
              "type": "string",
              "enum": [
                "code_snippet",
                "contextual",
                "agent",
                "thumbs_only"
              ],
              "description": "Filtrer par source des retours"
            },
            "required": false,
            "name": "source",
            "in": "query"
          },
          {
            "schema": {
              "type": "string",
              "description": "Liste des statuts à filtrer, séparés par des virgules"
            },
            "required": false,
            "name": "status",
            "in": "query"
          },
          {
            "schema": {
              "type": "number",
              "minimum": 1,
              "maximum": 100,
              "default": 50,
              "description": "Nombre maximal de résultats par page"
            },
            "required": false,
            "name": "limit",
            "in": "query"
          },
          {
            "schema": {
              "type": "string",
              "description": "Curseur de pagination"
            },
            "required": false,
            "name": "cursor",
            "in": "query"
          }
        ],
        "responses": {
          "200": {
            "description": "Données de retours avec pagination",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/FeedbackResponse"
                }
              }
            }
          },
          "400": {
            "description": "Paramètres de requête non valides",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AnalyticsErrorResponse"
                }
              }
            }
          },
          "500": {
            "description": "Erreur serveur",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AnalyticsErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/v1/analytics/{projectId}/feedback/by-page": {
      "get": {
        "summary": "Récupérer les retours par page",
        "description": "Renvoie le nombre de retours agrégés par chemin de page de documentation (votes positifs/négatifs pour les retours contextuels, nombre d’extraits de code et total par page)",
        "tags": [
          "Analytics"
        ],
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "$ref": "#/components/parameters/projectId"
          },
          {
            "schema": {
              "type": "string",
              "description": "Date au format ISO 8601 ou YYYY-MM-DD",
              "example": "2024-01-01"
            },
            "required": false,
            "name": "dateFrom",
            "in": "query"
          },
          {
            "schema": {
              "type": "string",
              "description": "Date au format ISO 8601 ou YYYY-MM-DD. `dateTo` est une borne supérieure exclusive. Les résultats incluent les dates antérieures à la date spécifiée, mais pas la date elle-même.",
              "example": "2024-01-01"
            },
            "required": false,
            "name": "dateTo",
            "in": "query"
          },
          {
            "schema": {
              "type": "number",
              "minimum": 1,
              "maximum": 100,
              "default": 10,
              "description": "Nombre maximal de résultats par page"
            },
            "required": false,
            "name": "limit",
            "in": "query"
          },
          {
            "schema": {
              "type": "string",
              "enum": [
                "code_snippet",
                "contextual",
                "agent",
                "thumbs_only"
              ],
              "description": "Filtrer par source des retours"
            },
            "required": false,
            "name": "source",
            "in": "query"
          },
          {
            "schema": {
              "type": "string",
              "description": "Liste des statuts à filtrer, séparés par des virgules"
            },
            "required": false,
            "name": "status",
            "in": "query"
          }
        ],
        "responses": {
          "200": {
            "description": "Agrégats des retours par page avec indicateur de pagination",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/FeedbackGroupedByPageResponse"
                }
              }
            }
          },
          "400": {
            "description": "Paramètres de requête non valides",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AnalyticsErrorResponse"
                }
              }
            }
          },
          "500": {
            "description": "Erreur serveur",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AnalyticsErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/v1/analytics/{projectId}/assistant": {
      "get": {
        "summary": "Récupérer les conversations de l’assistant",
        "description": "Renvoie l’historique paginé des conversations de l’assistant IA",
        "tags": [
