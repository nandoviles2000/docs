          "Analytics"
        ],
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "$ref": "#/components/parameters/projectId"
          },
          {
            "schema": {
              "type": "string",
              "description": "Date au format ISO 8601 ou YYYY-MM-DD",
              "example": "2024-01-01"
            },
            "required": false,
            "name": "dateFrom",
            "in": "query"
          },
          {
            "schema": {
              "type": "string",
              "description": "Date au format ISO 8601 ou YYYY-MM-DD. `dateTo` est une borne supérieure exclusive. Les résultats incluent les dates antérieures à la date spécifiée, mais pas la date elle-même.",
